# Copy to .env and fill in. Never commit .env.

# Postgres + pgvector running in Docker (docker compose up -d)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/regs

# LLM provider (OpenAI-compatible API). Groq free tier by default.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
